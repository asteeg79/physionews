# ── KI-Klassifizierung ────────────────────────────────────────────────────
# Google Gemini (gemini-2.5-flash-lite). Ohne Key läuft die Bewertung
# rein über Keywords — die App funktioniert, nur weniger treffsicher.
# Gehört als Repository-Secret nach GitHub (die Pipeline braucht ihn),
# in Vercel wird er nicht gebraucht.
GEMINI_API_KEY=AIza...

# ── Web Push (VAPID) ──────────────────────────────────────────────────────
# Erzeugen: npx web-push generate-vapid-keys
# VAPID_* brauchen GitHub (Versand aus der Pipeline) und Vercel (Test-Push).
VAPID_PUBLIC_KEY=BHW...
VAPID_PRIVATE_KEY=abc...
VAPID_SUBJECT=mailto:deine-email@example.com

# Öffentlicher VAPID-Key (im Frontend sichtbar, kein Geheimnis)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BHW...

# Verschlüsselt data/push-subscriptions.enc.json. Das Repository ist
# öffentlich, deshalb liegen die Push-Schlüssel dort nur verschlüsselt.
# Erzeugen: openssl rand -hex 32
# Muss in GitHub UND Vercel identisch hinterlegt sein.
PUSH_STORE_KEY=0123456789abcdef...

# ── Schreibzugriff aufs Repository (nur Vercel) ───────────────────────────
# Auf Vercel ist das Dateisystem read-only. Änderungen des Nutzers
# (Einstellungen, Quellen, Push-Anmeldung) werden deshalb als Commit über
# die GitHub-Contents-API geschrieben.
# Token: Fine-grained PAT mit "Contents: read and write" — und
# "Actions: write", damit der Refresh-Knopf die Pipeline anstoßen kann.
GITHUB_TOKEN=github_pat_...
GITHUB_REPO=asteeg79/physionews
# Optional, Default "main"
GITHUB_BRANCH=main

# ── Nur für Sonderfälle ───────────────────────────────────────────────────
# Erzwingt den Schreibweg: "fs" (lokal/Actions) oder "github" (Vercel).
# Ohne Angabe: github, sobald VERCEL gesetzt ist, sonst fs.
# DATA_WRITE_MODE=fs
